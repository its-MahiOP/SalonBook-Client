# ---------------------------------------------------------------------------
# SalonBook client - copy to `.env` and fill in your own values.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Public URL of this Next.js app (used for auth callbacks and SEO metadata)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the Express API
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:5000
SERVER_BASE_URL=http://localhost:5000

# Better Auth
# Generate with: npx auth secret
BETTER_AUTH_SECRET=

# MongoDB (same database the Express server uses)
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB API key used for service images and profile avatars
# https://api.imgbb.com/
IMGBB_API_KEY=

# Only used by `npm run seed:admin` to promote an existing account
ADMIN_EMAIL=admin@salonbook.com
ADMIN_PASSWORD=SalonBook123
ADMIN_NAME=SalonBook Administrator
